# ---------------------------------------------------------------------------
# Pay API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# GET /api/health reports whether what is here is enough to run the product:
# `usable: false` means the site is up and Pay is not.
#
# See docs/DEPLOYMENT.md and docs/PAY_ARCHITECTURE.md.
# ---------------------------------------------------------------------------


# --- Identity --------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart, and
# read by the code that refuses to do local-only things on a live host.
APP_ENV=production

# This product's name. Sent to the other products as the caller identity and as
# the re-entry guard, and it prefixes every idempotency key Pay mints. Changing
# it on a live host makes in-flight retries look like new requests.
APP_PRODUCT_KEY=pay


# --- Database (REQUIRED) ---------------------------------------------------
#
# Pay's own database and nothing else. This app never connects to another
# product's database — it asks that product over HTTP — so these credentials
# should grant access to this one schema and no more.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pay_prod
DB_USER=
DB_PASS=

# Only if the tables do not live in "public".
# DB_SCHEMA=public


# --- Encryption (REQUIRED) -------------------------------------------------
#
# Merchants' gateway credentials are encrypted with AES-256-GCM before they are
# written. Without this key the API answers 503 rather than storing a secret in
# the clear — there is no plaintext fallback, deliberately.
#
# Format: <id>:<32 bytes, base64>. The id is stored in the ciphertext so old
# rows stay readable after a rotation.
#
#   php -r 'echo "1:" . base64_encode(random_bytes(32)) . "\n";'
#
# Keep it OUT of the repository, out of backups that leave the host, and out of
# anywhere the database backup also goes — a key beside the ciphertext it
# protects is not a key.
PAY_ENCRYPTION_KEY=

# During a rotation, the PREVIOUS key. New writes use PAY_ENCRYPTION_KEY; reads
# fall back to this one, so nothing has to be re-encrypted in a maintenance
# window. Leave it in place until every stored credential has been re-saved
# under the new id — testing a connection on the Gateways screen re-writes it.
# PAY_ENCRYPTION_KEY_OLD=

# Pepper for hashed API key secrets. These are HASHED, not encrypted: the
# plaintext is shown once at creation and is then unrecoverable, which is the
# point. Changing this invalidates every API key that was issued under it.
#
#   php -r 'echo bin2hex(random_bytes(32)) . "\n";'
PAY_HASH_PEPPER=

# Signs the events Pay POSTs to source apps and to merchant webhook endpoints.
# The receiving side verifies with the same secret over the RAW body.
#
#   php -r 'echo bin2hex(random_bytes(32)) . "\n";'
PAY_CALLBACK_SIGNING_SECRET=


# --- Public URLs -----------------------------------------------------------

# Where a payment link points. This is what a customer sees in their SMS, so it
# must be the public origin of the app, not of the API.
PAY_PUBLIC_BASE=https://pay.aicountly.com

# AICOUNTLY portal auth API. Leave unset unless you are pointing at a
# non-standard portal — my.aicountly.com serves BOTH production and sandbox.
# (sandbox.aicountly.com is a login redirect only; it does not serve seskey or
# validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# --- Talking to the other products -----------------------------------------
#
# Every one of these is a LIVE HTTP call. There is no database link between Pay
# and any other product and there will not be one — see PAY_ARCHITECTURE.md §1.
#
# The base URLs are DERIVED FROM THIS HOST and normally need nothing here: a
# request arriving at pay.aicountly.com calls the other products' production
# hosts, and one arriving at pay.gh.aicountly.com calls their sandboxes. Set one
# only to point somewhere else — a local instance, or a cutover.
#
# MANAGE_API_BASE=https://manage.aicountly.com
# BOOKS_API_BASE=https://books.aicountly.com
# BILLING_API_BASE=https://billing.aicountly.com
# SALES_API_BASE=https://sales.aicountly.com
# POS_API_BASE=https://pos.aicountly.com

# A source app can be switched off without a deploy. Unset means available.
# BOOKS_ENABLED=1
# BILLING_ENABLED=1
# SALES_ENABLED=1
# POS_ENABLED=1


# --- Service keys ----------------------------------------------------------
#
# OUTBOUND: the key Pay presents when it calls a sibling as itself rather than
# as the signed-in user — reading the invoice behind a payment request, posting
# the receipt back. Issued by that product. Without them those calls are
# rejected: the payment still succeeds, and the source app is told late, from
# the outbox, with the failure visible on the Developers screen.

BOOKS_SERVICE_KEY=
BILLING_SERVICE_KEY=
SALES_SERVICE_KEY=
POS_SERVICE_KEY=

# INBOUND: keys Pay ACCEPTS from its siblings, as app:key pairs. Give each
# product its own so a leak can be traced and rotated on its own.
# SERVICE_KEYS=books:<key>,billing:<key>,sales:<key>,pos:<key>


# --- Payment providers: DIRECT ---------------------------------------------
#
# DIRECT means the merchant's own gateway account. Their credentials are entered
# on the Gateways screen and stored encrypted; nothing about a merchant's
# gateway belongs in this file.
#
# These flags only say which providers this deployment will accept a connection
# for. All four default ON — a host that has not thought about flags should
# still be able to connect Razorpay.
#
# DIRECT_RAZORPAY_ENABLED=1
# DIRECT_CASHFREE_ENABLED=1
# DIRECT_STRIPE_ENABLED=1
# DIRECT_PAYU_ENABLED=1


# --- Payment providers: MANAGED --------------------------------------------
#
# MANAGED means Aicountly's own partner arrangement: merchants onboard through
# Pay and money settles through the partner. These are AICOUNTLY's credentials,
# not a merchant's, which is why they live here and never in the database — a
# company row must not be able to reach them.
#
# NOT LIVE. The code is complete; the partner agreement is not. With these
# unset every managed call returns `partner_not_configured` and the UI says
# "Partner credentials not configured" rather than pretending. Managed defaults
# OFF everywhere: a deployment turns it on when an agreement exists, not before.
#
# MANAGED_CASHFREE_ENABLED=0
# PAY_MANAGED_CASHFREE_KEY_ID=CHANGE_ME
# PAY_MANAGED_CASHFREE_KEY_SECRET=CHANGE_ME
# PAY_MANAGED_CASHFREE_WEBHOOK_SECRET=CHANGE_ME
#
# MANAGED_RAZORPAY_ENABLED=0
# PAY_MANAGED_RAZORPAY_KEY_ID=CHANGE_ME
# PAY_MANAGED_RAZORPAY_KEY_SECRET=CHANGE_ME
# PAY_MANAGED_RAZORPAY_WEBHOOK_SECRET=CHANGE_ME


# --- Pay Pulse -------------------------------------------------------------
#
# Payment intelligence computed from THIS company's own payments. Unset means
# on. It recommends and does not act: auto-optimisation is a per-company setting
# that is off by default, and this flag does not turn it on.
# PAY_PULSE_ENABLED=1


# --- Local development only ------------------------------------------------
#
# A fake gateway that takes payments without a real account, so the whole flow
# can be driven end to end locally. It REFUSES to exist in production — the
# constructor throws and the registry will not build it — so this line is
# harmless if it follows you onto a live host, but it does not belong there.
# MOCK_PROVIDER_ENABLED=1
